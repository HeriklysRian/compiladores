/* Exemplo de um programa escrito em SIMPLES */

programa
inicio
   inteiro a <- 9;
   inteiro b <- 5;
   inteiro c <- 7;
   flutuante d <- d+b;
   flutuante g <- c+a;
   flutuante f <- f+a;
   flutuante r <- r+b;
   flutuante p <- p+r;
   flutuante e <- e+a;
   b <- a + b;
   escreva b;
   leia c;

fim

